    "name": "huo-jian-q",
    "email": "56460319+hjq-cpu@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjq-cpu/n8n-nodes-webdav-zh.git"
  },
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node",
    "webdav",
    "webdav-client",
    "webdav-server",
    "webdav-protocol",
    "file-operations",
    "nextcloud",
    "owncloud",
    "microsoft-sharepoint",
    "中文",
    "chinese"
  ],
  "main": "dist/index.js",
  "scripts": {
    "test": "node test-manual.js",
