    ],
    "nodes": [
      "dist/nodes/WebDav/WebDav.node.js"
    ]
  },
  "dependencies": {
    "axios": "^1.3.6",
    "fast-xml-parser": "^4.3.2",
    "n8n-core": "^1.0.0",
    "n8n-workflow": "^1.0.0",
    "webdav": "^5.2.2"
